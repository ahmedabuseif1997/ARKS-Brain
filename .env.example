# ── Ecosine configuration ──────────────────────────────────────────────
# Copy to `.env` and paste your keys in. Never commit `.env`.

# ══ BRAIN + VOICE — MiniMax (one key does both) ════════════════════════
# Your MiniMax key. Powers replies AND speech generation.
OPENAI_COMPAT_API_KEY=

# Verified working models: MiniMax-M3, MiniMax-M2, MiniMax-Text-01
# OPENAI_COMPAT_MODEL=MiniMax-M3
# OPENAI_COMPAT_URL=https://api.minimax.io/v1
# OPENAI_COMPAT_LABEL=MiniMax

# ── Speech: posh British female (verified) ─────────────────────────────
# English_Graceful_Lady     classic RP, elegant          ← default
# English_compelling_lady1  authoritative newsreader
# English_Wiselady          warmer, genial
# English_SentimentalLady   softer, elegant
# TTS_VOICE=English_Graceful_Lady
# TTS_MODEL=speech-2.5-hd-preview
# TTS_SPEED=1.0
# TTS_ENABLED=true

# ══ WEB SEARCH ═════════════════════════════════════════════════════════
# Free tier: https://app.tavily.com — key starts with tvly-
TAVILY_API_KEY=

# ══ ALTERNATIVE BRAINS (optional) ══════════════════════════════════════
# Only used if OPENAI_COMPAT_API_KEY above is blank.

# Free: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Paid, sharpest: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Fully local, no account (needs https://ollama.com + `ollama pull qwen2.5:7b`)
# OLLAMA_MODEL=qwen2.5:7b

# ══ WHERE YOU ARE ══════════════════════════════════════════════════════
# Drives the clock, the Friday weekly-report deadline and the morning
# weather. Defaults below are Dubai; change them to your own.
# TIMEZONE=Asia/Dubai
# PLACE_NAME=Dubai
# PLACE_LAT=25.2048
# PLACE_LON=55.2708

# ══ MAIL ═══════════════════════════════════════════════════════════════
# IMAP read + SMTP send, Python stdlib only. The host must be a name the
# server's certificate actually covers. Never put the password here — run
# ./setup-mail.sh and it goes to the macOS Keychain instead.
# MAIL_HOST=
# MAIL_USER=

# PORT=7777
